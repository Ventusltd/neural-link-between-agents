From f8258a01978a4b6f29dd2a248864a6283f18c02a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 31 Oct 2026 21:14:02 +0000
Subject: [PATCH] dcmerge: canonicalise operator inside operator_match only
 (NL-007 P1)

Add _op_core(), which replaces a parenthesised tail with a space, and
compare norm_operator(_op_core(a)) with norm_operator(_op_core(b)) in
operator_match. Equality stays exact; norm_operator, geo_key, site_key
and every site id are untouched. A gloss such as "Slough Holdings UK
Limited (SDC Capital Partners)" no longer hard-splits from "Slough
Holdings UK Limited" in cannot_link (Wapseys Wood, PINS EN0110030).

New test test_parenthesised_operator_gloss_is_not_a_split: one operator
with and without a gloss merges in both input orders (one site, two
sources, exact_site, 300 MW, no operator_disagreement), and
operator_match("Digital Realty", "Global Technical Realty") stays False.

Measured at this commit, from datacentres/lanes/dc-a7-merge:
python3 -m unittest test_dcmerge -> Ran 53 tests, OK (52 at b57c94d).
test_operator_match and the three cross-operator tests (Slough Campus)
are unchanged and pass. dcmerge.py 22,845 B sha256 f63ac9e2...7c60;
test_dcmerge.py 29,292 B sha256 08c21f2f...77a1. The pipeline output
and MANIFEST.json are rebuilt in the next commit (P2).

Co-Authored-By: Claude Opus <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015ELZDBhAFNgtcsrTUSi1vm
---
 datacentres/lanes/dc-a7-merge/dcmerge.py      |  8 +++++++-
 datacentres/lanes/dc-a7-merge/test_dcmerge.py | 17 +++++++++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/datacentres/lanes/dc-a7-merge/dcmerge.py b/datacentres/lanes/dc-a7-merge/dcmerge.py
index 27c9cff..9877496 100644
--- a/datacentres/lanes/dc-a7-merge/dcmerge.py
+++ b/datacentres/lanes/dc-a7-merge/dcmerge.py
@@ -119,8 +119,14 @@ def name_similarity(a, b):
     return round(max(jac, seq), 4)
 
 
+def _op_core(s):
+    # A parenthesised tail is a gloss on one operator ("Slough Holdings UK Limited (SDC Capital
+    # Partners)", "X Ltd (appellant)"), not a second operator: drop it before comparing.
+    return re.sub(r"\([^)]*\)", " ", s or "")
+
+
 def operator_match(a, b):
-    na, nb = norm_operator(a), norm_operator(b)
+    na, nb = norm_operator(_op_core(a)), norm_operator(_op_core(b))
     if not na or not nb:
         return None  # unknown
     # Subset matching is unsafe: Digital Realty must not match Global Digital
diff --git a/datacentres/lanes/dc-a7-merge/test_dcmerge.py b/datacentres/lanes/dc-a7-merge/test_dcmerge.py
index 8081789..f9b8966 100644
--- a/datacentres/lanes/dc-a7-merge/test_dcmerge.py
+++ b/datacentres/lanes/dc-a7-merge/test_dcmerge.py
@@ -159,6 +159,23 @@ class MergeTests(unittest.TestCase):
                operator="Global Technical Realty")
         self.assertEqual(len(dcmerge.merge([a, b])), 2)
 
+    def test_parenthesised_operator_gloss_is_not_a_split(self):
+        # False-split guard (Wapseys Wood, PINS EN0110030): one operator written with and without a
+        # parenthesised gloss is one operator; the cross-operator guard above must still hold.
+        a = mk("DC-A3", "government", "s35-wapseys", "SDC M40 Campus (Wapseys Wood)", 51.58696, -0.59697,
+               operator="Slough Holdings UK Limited (SDC Capital Partners)", it=300)
+        b = mk("DC-A2", "planning", "EN0110030", "SDC M40 Campus (Wapseys Wood)",
+               operator="Slough Holdings UK Limited", it=300)
+        self.assertTrue(dcmerge.operator_match(a["operator"], b["operator"]))
+        self.assertFalse(dcmerge.operator_match("Digital Realty", "Global Technical Realty"))
+        for order in ([a, b], [b, a]):
+            out = dcmerge.merge(order)
+            self.assertEqual(len(out), 1)
+            self.assertEqual(len(out[0]["sources"]), 2)
+            self.assertEqual(out[0]["location"]["precision"], "exact_site")
+            self.assertEqual(out[0]["it_load_mw"]["value"], 300)
+            self.assertFalse([c for c in out[0]["conflicts"] if c["kind"] == "operator_disagreement"])
+
     def test_cross_operator_shared_document_and_ref_never_merge(self):
         url = "https://assets.publishing.service.gov.uk/media/abcd/shared.pdf"
         a = mk("DC-A2", "planning", "1", "Slough Campus", 51.517, -0.618,
