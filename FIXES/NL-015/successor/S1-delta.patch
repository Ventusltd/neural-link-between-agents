+    test ! -e "$RELEASE/$relative" || { echo "should not be copied: $relative" >&2; exit 1; }
+    continue
+  fi
+  cmp -s "$file" "$RELEASE/$relative" || { echo "inherited file differs from parent: $relative" >&2; exit 1; }
+done < <(walk "$PARENT")
+while IFS= read -r file; do
