[{"name":"01-boot-desktop","url":"https://ventusltd.github.io/gridatlas/atlas/","viewport":[1400,900],
 "steps":[{"wait":30000,"shot":true,"label":"probe","eval":"(()=>{const M=window.__GRIDATLAS_MODULES__||{};const ids=[...document.querySelectorAll('input[data-layer-id]')].map(i=>i.dataset.layerId+(i.checked?'*':'')+'|'+((i.closest('label')||i.parentElement||{}).innerText||'').trim().slice(0,40));return {router:document.body.dataset.gridatlasRouter,modules:Object.keys(M),layers:ids,keyGroups:[...document.querySelectorAll('#scada-ui-container .key-group')].map(g=>g.innerText.replace(/\\s+/g,' ').slice(0,200)),ot:!!M.ukOfftakers,body:document.body.innerText.replace(/\\s+/g,' ').slice(0,600)}})()"}]}]
